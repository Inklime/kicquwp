<Page
    x:Class="kicquwp.InfoPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:kicquwp"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="#FF0D1117">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <Border Grid.Row="0" Background="{ThemeResource SystemControlHighlightAccentBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="56"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Click="BackButton_Click"
                        Background="Transparent" BorderThickness="0"
                        Width="56" Height="56" Padding="0">
                    <FontIcon Glyph="&#xE0A6;" FontSize="20" Foreground="White"/>
                </Button>
                <TextBlock Grid.Column="1" Text="О приложении"
                           FontSize="20" FontWeight="SemiBold"
                           Foreground="White" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0">

                <!-- Лого блок -->
                <Border Background="{ThemeResource SystemControlHighlightAccentBrush}"
                        Padding="0,40,0,40" Margin="0,0,0,0">
                    <StackPanel HorizontalAlignment="Center">
                        <Image Source="ms-appx:///Assets/Medlogo.png" Width="200" Height="124" />
                        <TextBlock Text="KICQ"
                                   FontSize="32" FontWeight="Light"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   CharacterSpacing="300"
                                   Margin="0,12,0,0"/>
                        <TextBlock Text="ICQ клиент для Windows"
                                   FontSize="14"
                                   Foreground="#CCFFFFFF"
                                   HorizontalAlignment="Center"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- О приложении -->
                <Border Background="#FF161B22" Padding="16,16,16,16" Margin="0,0,0,1">
                    <StackPanel>
                        <TextBlock Text="О приложении"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="{ThemeResource SystemControlHighlightAccentBrush}"
                                   CharacterSpacing="150" Margin="0,0,0,8"/>
                        <TextBlock Text="kicq — ICQ клиент, реализующий протокол OSCAR. Поддерживает список контактов с группами, обмен сообщениями, статусы, смайлики, уведомления и фоновое переподключение."
                                   FontSize="16" Foreground="White"
                                   TextWrapping="Wrap" LineHeight="24"/>
                    </StackPanel>
                </Border>

                <!-- Сервер -->
                <Border Background="#FF161B22" Padding="16,16,16,16" Margin="0,0,0,1">
                    <StackPanel>
                        <TextBlock Text="СЕРВЕР"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="{ThemeResource SystemControlHighlightAccentBrush}"
                                   CharacterSpacing="150" Margin="0,0,0,8"/>
                        <TextBlock Text="kicq.ru"
                                   FontSize="16" Foreground="White"/>
                        <TextBlock Text="Совместим только с серверами kicq"
                                   FontSize="13" Foreground="#66FFFFFF"
                                   TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Возможности -->
                <Border Background="#FF161B22" Padding="16,16,16,16" Margin="0,0,0,1">
                    <StackPanel>
                        <TextBlock Text="ВОЗМОЖНОСТИ"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="{ThemeResource SystemControlHighlightAccentBrush}"
                                   CharacterSpacing="150" Margin="0,0,0,12"/>

                        <local:FeatureItem Icon="&#xE8D4;" Text="Обмен сообщениями в реальном времени"/>
                        <local:FeatureItem Icon="&#xE77B;" Text="Список контактов с группами"/>
                        <local:FeatureItem Icon="&#xE734;" Text="Статусы и уведомления о печати"/>
                        <local:FeatureItem Icon="&#xE715;" Text="Push-уведомления в фоне"/>
                        <local:FeatureItem Icon="&#xE76E;" Text="Смайлики в стиле QIP"/>
                        <local:FeatureItem Icon="&#xE8BB;" Text="История сообщений"/>
                        <local:FeatureItem Icon="&#xE8EF;" Text="Поиск пользователей"/>
                        <local:FeatureItem Icon="&#xE7C3;" Text="Настраиваемые фоны и темы"/>
                    </StackPanel>
                </Border>

                <!-- Автор -->
                <Border Background="#FF161B22" Padding="16,16,16,16" Margin="0,0,0,1">
                    <StackPanel>
                        <TextBlock Text="РАЗРАБОТЧИК"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="{ThemeResource SystemControlHighlightAccentBrush}"
                                   CharacterSpacing="150" Margin="0,0,0,8"/>
                        <TextBlock Text="blackblur13 (Inklime)"
                                   FontSize="18" Foreground="White"/>
                        <TextBlock Text="UIN: 748807203"
                                   FontSize="14" Foreground="#88FFFFFF"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Версия -->
                <Border Background="#FF161B22" Padding="16,16,16,16" Margin="0,0,0,0">
                    <StackPanel>
                        <TextBlock Text="ВЕРСИЯ"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="{ThemeResource SystemControlHighlightAccentBrush}"
                                   CharacterSpacing="150" Margin="0,0,0,8"/>
                        <TextBlock x:Name="VersionText"
                                   Text="1.0.0"
                                   FontSize="16" Foreground="White"/>
                        <TextBlock Text="Протокол: OSCAR ICQ v7/v8/v9"
                                   FontSize="13" Foreground="#66FFFFFF"
                                   Margin="0,4,0,0"/>
                        <TextBlock Text="Сделано с ❤️ для сообщества kicq"
                                   FontSize="13" Foreground="#66FFFFFF"
                                   TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <Border Height="20"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>

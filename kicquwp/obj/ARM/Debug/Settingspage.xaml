<Page
    x:Class="kicquwp.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="#FF0D1117">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <Border Grid.Row="0" Background="{ThemeResource SystemControlHighlightAccentBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="56"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ИСПРАВЛЕННАЯ КНОПКА НАЗАД -->
                <Button x:ConnectionId='18' Grid.Column="0"                         
                        Background="Transparent" BorderThickness="0"
                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Padding="0">
                    <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE72B;" Foreground="White" FontSize="20"/>
                </Button>

                <TextBlock Grid.Column="1" Text="Настройки"
                           FontSize="20" FontFamily="Segoe WP"
                           FontWeight="SemiBold" Foreground="White"
                           VerticalAlignment="Center" Margin="8,0,0,0"/>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0">

                <Border Background="{ThemeResource SystemControlHighlightAccentBrush}" Padding="16,10,16,10" Margin="0,0,0,1">
                    <TextBlock Text="СОЕДИНЕНИЕ"
                               FontSize="13" FontFamily="Segoe WP"
                               FontWeight="SemiBold" Foreground="White"
                               CharacterSpacing="150"/>
                </Border>

                <Border x:ConnectionId='2' x:Name="BackgroundModeBorder" Background="#FF161B22" Padding="16,0,16,0" Margin="0,0,0,1">
                    <Grid MinHeight="56">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Работа в фоне"
                                       FontSize="17" FontFamily="Segoe WP" Foreground="White"/>
                            <TextBlock Text="Приложение работает всегда"
                                       FontSize="13" FontFamily="Segoe WP" Foreground="#66FFFFFF"/>
                        </StackPanel>
                        <ToggleSwitch x:ConnectionId='17' x:Name="BackgroundModeToggle"
                                      Grid.Column="1"
                                                                            
                                      VerticalAlignment="Center"
                                      Margin="0,8,0,8"/>
                    </Grid>
                </Border>

                <!-- Секция: Список контактов -->
                <Border Background="{ThemeResource SystemControlHighlightAccentBrush}" Padding="16,10,16,10" Margin="0,0,0,1">
                    <TextBlock Text="КОНТАКТЫ"
                               FontSize="13" FontFamily="Segoe WP"
                               FontWeight="SemiBold" Foreground="White"
                               CharacterSpacing="150"/>
                </Border>

                <!-- Показывать группы -->
                <Border Background="#FF161B22" Padding="16,0,16,0" Margin="0,0,0,1">
                    <Grid MinHeight="56">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Показывать группы"
                                       FontSize="17" FontFamily="Segoe WP"
                                       Foreground="White"/>
                            <TextBlock Text="Разбить контакты по группам"
                                       FontSize="13" FontFamily="Segoe WP"
                                       Foreground="#66FFFFFF"/>
                        </StackPanel>
                        <ToggleSwitch x:ConnectionId='16' x:Name="ShowGroupsToggle"
                                      Grid.Column="1"
                                                                        
                                      VerticalAlignment="Center"
                                      Margin="0,8,0,8"/>
                    </Grid>
                </Border>

                <!-- Скрывать офлайн -->
                <Border Background="#FF161B22" Padding="16,0,16,0" Margin="0,0,0,1">
                    <Grid MinHeight="56">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Скрывать офлайн"
                                       FontSize="17" FontFamily="Segoe WP"
                                       Foreground="White"/>
                            <TextBlock Text="Только контакты в сети"
                                       FontSize="13" FontFamily="Segoe WP"
                                       Foreground="#66FFFFFF"/>
                        </StackPanel>
                        <ToggleSwitch x:ConnectionId='15' x:Name="HideOfflineToggle"
                                      Grid.Column="1"
                                                                         
                                      VerticalAlignment="Center"
                                      Margin="0,8,0,8"/>
                    </Grid>
                </Border>

                <!-- Уведомления о печати -->
                <Border Background="#FF161B22" Padding="16,0,16,0" Margin="0,0,0,1">
                    <Grid MinHeight="56">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Уведомления о печати"
                                       FontSize="17" FontFamily="Segoe WP"
                                       Foreground="White"/>
                            <TextBlock Text="Отправлять увед. о печати"
                                       FontSize="13" FontFamily="Segoe WP"
                                       Foreground="#66FFFFFF"/>
                        </StackPanel>
                        <ToggleSwitch x:ConnectionId='14' x:Name="TypingNotificationsToggle"
                                      Grid.Column="1"
                                                                                 
                                      VerticalAlignment="Center"
                                      Margin="0,8,0,8"/>
                    </Grid>
                </Border>

                <!-- Секция: Фон -->
                <Border Background="{ThemeResource SystemControlHighlightAccentBrush}" Padding="16,10,16,10"
                        Margin="0,16,0,1">
                    <TextBlock Text="ФОН СПИСКА КОНТАКТОВ"
                               FontSize="13" FontFamily="Segoe WP"
                               FontWeight="SemiBold" Foreground="White"
                               CharacterSpacing="150"/>
                </Border>

                <!-- Текущий фон -->
                <Border Background="#FF161B22" Padding="16,12,16,12" Margin="0,0,0,1">
                    <StackPanel>
                        <TextBlock Text="Текущий фон"
                                   FontSize="14" FontFamily="Segoe WP"
                                   Foreground="#88FFFFFF" Margin="0,0,0,8"/>
                        <Border x:ConnectionId='12' x:Name="BackgroundPreview"
                                Height="80" Background="#FF0D1117"
                                Margin="0,0,0,0">
                            <TextBlock x:ConnectionId='13' x:Name="BackgroundPreviewText"
                                       Text="Фон не выбран"
                                       FontSize="14" FontFamily="Segoe WP"
                                       Foreground="#44FFFFFF"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Выбрать фото -->
                <Border Background="#FF161B22" Padding="0,0,0,0" Margin="0,0,0,1">
                    <Button x:ConnectionId='11'                             
                            Background="Transparent"
                            BorderThickness="0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Padding="16,16,16,16">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE114;" FontFamily="Segoe UI Symbol"
                                       FontSize="22" Foreground="{ThemeResource SystemControlHighlightAccentBrush}"
                                       VerticalAlignment="Center" Margin="0,0,14,0"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Выбрать изображение"
                                           FontSize="17" FontFamily="Segoe WP"
                                           Foreground="White"/>
                                <TextBlock Text="Из галереи телефона"
                                           FontSize="13" FontFamily="Segoe WP"
                                           Foreground="#66FFFFFF"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>
                </Border>

                <!-- Очистить фон -->
                <Border Background="#FF161B22" Padding="0,0,0,0" Margin="0,0,0,1">
                    <Button x:ConnectionId='10'                              
                            Background="Transparent"
                            BorderThickness="0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Padding="16,16,16,16">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE107;" FontFamily="Segoe UI Symbol"
                                       FontSize="22" Foreground="#FFFF4444"
                                       VerticalAlignment="Center" Margin="0,0,14,0"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Убрать фон"
                                           FontSize="17" FontFamily="Segoe WP"
                                           Foreground="White"/>
                                <TextBlock Text="Вернуть стандартный тёмный фон"
                                           FontSize="13" FontFamily="Segoe WP"
                                           Foreground="#66FFFFFF"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>
                </Border>

                <!-- Прозрачность фона -->
                <Border Background="#FF161B22" Padding="16,12,16,12" Margin="0,0,0,1">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Прозрачность фона"
                                       FontSize="17" FontFamily="Segoe WP"
                                       Foreground="White" VerticalAlignment="Center"/>
                            <TextBlock x:ConnectionId='9' x:Name="OpacityValueText"
                                       Grid.Column="1" Text="100%"
                                       FontSize="17" FontFamily="Segoe WP"
                                       Foreground="{ThemeResource SystemControlHighlightAccentBrush}" VerticalAlignment="Center"/>
                        </Grid>
                        <Slider x:ConnectionId='8' x:Name="BackgroundOpacitySlider"
                                Minimum="10" Maximum="100" Value="100"
                                                                         
                                Foreground="{ThemeResource SystemControlHighlightAccentBrush}"/>
                    </StackPanel>
                </Border>

                <!-- ПРОЗРАЧНОСТЬ КНОПОК КОНТАКТОВ -->
                <Border Background="{ThemeResource SystemControlHighlightAccentBrush}" Padding="16,10,16,10" Margin="0,16,0,1">
                    <TextBlock Text="ПРОЗРАЧНОСТЬ КНОПОК КОНТАКТОВ"
                               FontSize="13" FontFamily="Segoe WP"
                               FontWeight="SemiBold" Foreground="White"
                               CharacterSpacing="150"/>
                </Border>

                <Border Background="#FF161B22" Padding="16,12,16,12" Margin="0,0,0,1">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Прозрачность элементов"
                                       FontSize="17" FontFamily="Segoe WP"
                                       Foreground="White" VerticalAlignment="Center"/>
                            <TextBlock x:ConnectionId='7' x:Name="ContactOpacityText"
                                       Grid.Column="1" Text="100%"
                                       FontSize="17" FontFamily="Segoe WP"
                                       Foreground="{ThemeResource SystemControlHighlightAccentBrush}" VerticalAlignment="Center"/>
                        </Grid>
                        <Slider x:ConnectionId='6' x:Name="ContactOpacitySlider"
                                Minimum="0" Maximum="100" Value="100"
                                                                                
                                Foreground="{ThemeResource SystemControlHighlightAccentBrush}"/>
                    </StackPanel>
                </Border>

                <!-- Фон чата -->
                <Border Background="{ThemeResource SystemControlHighlightAccentBrush}" Padding="16,10,16,10" Margin="0,16,0,1">
                    <TextBlock Text="ФОН ЧАТА" FontSize="13" FontFamily="Segoe WP"
                               FontWeight="SemiBold" Foreground="White" CharacterSpacing="150"/>
                </Border>

                <Border Background="#FF161B22" Padding="0,0,0,0" Margin="0,0,0,1">
                    <Button x:ConnectionId='5'                                  Background="Transparent"
                            BorderThickness="0" HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left" Padding="16,16,16,16">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE114;" FontFamily="Segoe UI Symbol"
                                       FontSize="22" Foreground="{ThemeResource SystemControlHighlightAccentBrush}"
                                       VerticalAlignment="Center" Margin="0,0,14,0"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Выбрать изображение для чата"
                                           FontSize="17" FontFamily="Segoe WP" Foreground="White"/>
                                <TextBlock Text="Фон окна переписки"
                                           FontSize="13" FontFamily="Segoe WP" Foreground="#66FFFFFF"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>
                </Border>

                <Border Background="#FF161B22" Padding="0,0,0,0" Margin="0,0,0,1">
                    <Button x:ConnectionId='4'                                   Background="Transparent"
                            BorderThickness="0" HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left" Padding="16,16,16,16">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE107;" FontFamily="Segoe UI Symbol"
                                       FontSize="22" Foreground="#FFFF4444"
                                       VerticalAlignment="Center" Margin="0,0,14,0"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Убрать фон чата"
                                           FontSize="17" FontFamily="Segoe WP" Foreground="White"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>
                </Border>
                <!-- Секция: Опасные действия -->
                <Border Background="{ThemeResource SystemControlHighlightAccentBrush}" Padding="16,10,16,10" Margin="0,16,0,1">
                    <TextBlock Text="ОПАСНЫЕ ДЕЙСТВИЯ" FontSize="13" FontFamily="Segoe WP"
               FontWeight="SemiBold" Foreground="White" CharacterSpacing="150"/>
                </Border>

                <Border Background="#FF161B22" Padding="0,0,0,0" Margin="0,0,0,1">
                    <Button x:ConnectionId='3' x:Name="DeleteAccountButton"                             Background="Transparent"
            BorderThickness="0" HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Left" Padding="16,16,16,16">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE107;" FontFamily="Segoe UI Symbol"
                                       FontSize="22" Foreground="#FFFF4444"
                                       VerticalAlignment="Center" Margin="0,0,14,0"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Удалить аккаунт" FontSize="17" FontFamily="Segoe WP" Foreground="#FFFF4444"/>
                                <TextBlock Text="Безвозвратное удаление UIN" FontSize="13" FontFamily="Segoe WP" Foreground="#66FFFFFF"/>
                            </StackPanel>
                        </StackPanel>
                    </Button>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>


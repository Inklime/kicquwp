<Application
    x:Class="kicquwp.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>

            <!-- 1. ОПРЕДЕЛЯЕМ ВСЕ РЕСУРСЫ СНАЧАЛА -->
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#FF0D0D0D"/>
            <SolidColorBrush x:Key="AppChromeBrush"     Color="#FF1A1A1A"/>

            <!-- Исправлено: Color принимает только Color. SystemAccentColor — встроенный цветовой ресурс Windows -->
            <SolidColorBrush x:Key="AppAccentBrush" Color="{ThemeResource SystemAccentColor}"/>

            <x:Double x:Key="HeaderFontSize">28</x:Double>
            <x:Double x:Key="BodyFontSize">18</x:Double>

            <!-- 2. СТИЛИ (теперь ссылаются на уже существующие ресурсы) -->
            <Style x:Key="AccentButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource AppAccentBrush}"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Padding" Value="12,6"/>
                <Setter Property="Margin" Value="8"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
            </Style>

            <Style x:Key="ChatInputStyle" TargetType="TextBox">
                <Setter Property="Background" Value="#FF2A2A2A"/>
                <Setter Property="Foreground" Value="White"/>
                <!-- BorderBrush ожидает Brush, поэтому ThemeResource подходит идеально -->
                <Setter Property="BorderBrush" Value="{ThemeResource SystemControlHighlightAccentBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="8,6"/>
                <Setter Property="FontSize" Value="17"/>
                <Setter Property="FontFamily" Value="Segoe UI"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="MaxHeight" Value="120"/>
                <Setter Property="PlaceholderForeground" Value="#88FFFFFF"/>
                <Setter Property="VerticalAlignment" Value="Stretch"/>
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>

<Page
    x:Class="kicquwp.DebugLogPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#FF0D1117">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{ThemeResource SystemControlHighlightAccentBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="56"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:ConnectionId='4' Grid.Column="0"                         
                        Background="Transparent" BorderThickness="0"
                        Width="56" Height="56">
                    <FontIcon Glyph="&#xE0A6;" FontSize="20" Foreground="White"/>
                </Button>
                <TextBlock Grid.Column="1" Text="Лог отладки"
                           FontSize="18" Foreground="White"
                           VerticalAlignment="Center"/>
                <Button x:ConnectionId='5' Grid.Column="2"                         
                        Background="Transparent" BorderThickness="0"
                        Width="48" Height="56">
                    <FontIcon Glyph="&#xE8C8;" FontSize="18" Foreground="White"/>
                </Button>
                <Button x:ConnectionId='6' Grid.Column="3"                          
                        Background="Transparent" BorderThickness="0"
                        Width="48" Height="56">
                    <FontIcon Glyph="&#xE74D;" FontSize="18" Foreground="White"/>
                </Button>
            </Grid>
        </Border>

        <ScrollViewer x:ConnectionId='2' x:Name="LogScroll" Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      Padding="8">
            <TextBlock x:ConnectionId='3' x:Name="LogText"
                       FontFamily="Consolas"
                       FontSize="11"
                       Foreground="#CCFFFFFF"
                       TextWrapping="NoWrap"
                       IsTextSelectionEnabled="True"/>
        </ScrollViewer>
    </Grid>
</Page>

